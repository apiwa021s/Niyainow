# Public URLs (safe to expose to the browser). Production values are required
# at build time and must use HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_URL=https://images.example.com
# Optional Search Console ownership token (the content value only).
GOOGLE_SITE_VERIFICATION=

# PostgreSQL. Use a pooled managed connection string in serverless production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/niyainow
DATABASE_MAX_CONNECTIONS=5

# Redis is an optional cache only; PostgreSQL remains the source of truth.
# REDIS_URL (redis:// or rediss://) takes precedence over the discrete fields.
CACHE_ENABLED=true
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_TIMEOUT_MS=75
REDIS_DEBUG=false
REDIS_CACHE_PREFIX=niyainow
# Serialized values larger than this are served from PostgreSQL but not cached.
REDIS_MAX_ITEM_BYTES=1048576

# MongoDB source for the translated-novel import job.
MONGODB_URL=mongodb+srv://user:password@cluster.example.com/my-novel

# Explicit safety interlock for the mock-catalog development seed. Keep false
# outside a disposable development/staging database.
ALLOW_DEVELOPMENT_SEED=false

# Auth.js — Google OAuth only. Generate AUTH_SECRET with at least 32 characters.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Cloudflare R2 (server-only except the public asset URL above). Disable r2.dev;
# the dedicated cookie-less public CDN/Worker MUST deny and never cache /staging/*,
# preserve verified final Content-Type, and add X-Content-Type-Options: nosniff.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://images.example.com
R2_UPLOAD_URL_TTL_SECONDS=300

# Stripe Checkout. The webhook endpoint is /api/webhooks/stripe. Before going
# live, Stripe must explicitly approve the NovelNow business/content category.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# debug | info | warn | error | silent
LOG_LEVEL=info
