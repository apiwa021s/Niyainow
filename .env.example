# Public URLs (safe to expose to the browser). Production values are required
# at build time and must use HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_URL=https://images.example.com

# PostgreSQL. Use a pooled managed connection string in serverless production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/niyainow
DATABASE_MAX_CONNECTIONS=5

# Explicit safety interlock for the mock-catalog development seed. Keep false
# outside a disposable development/staging database.
ALLOW_DEVELOPMENT_SEED=false

# Auth.js — Google OAuth only. Generate AUTH_SECRET with at least 32 characters.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Cloudflare R2 (server-only except the public asset URL above). Disable r2.dev;
# the dedicated cookie-less public CDN/Worker MUST deny and never cache /staging/*,
# preserve verified final Content-Type, and add X-Content-Type-Options: nosniff.
R2_ACCOUNT_ID=b3d5f1608ade168f069735146966485c
R2_ACCESS_KEY_ID=28ed440c53c3391fe5dfeec757df6da9
R2_SECRET_ACCESS_KEY=0f0a377ad6861e2a99de98b3fdd6c7a26a657b8b8b4dc303a2729af413d22327
R2_BUCKET_NAME=niyainow
R2_PUBLIC_URL=https://pub-bca8a0281ab24d7eac82e822633097ae.r2.dev
R2_UPLOAD_URL_TTL_SECONDS=300

# debug | info | warn | error | silent
LOG_LEVEL=info
