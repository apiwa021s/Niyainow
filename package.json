{
  "name": "niyainow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx db/migrate.ts",
    "db:check-auth": "node --conditions=react-server --import tsx db/check-auth-schema.ts",
    "db:repair-auth": "node --conditions=react-server --import tsx db/repair-auth-schema.ts",
    "db:deploy": "npm run db:migrate && npm run db:seed-master && npm run db:check-auth",
    "db:seed-master": "tsx db/seed-master-data.ts",
    "db:publish-scheduled": "tsx db/publish-scheduled.ts",
    "db:process-outbox": "tsx db/process-outbox.ts",
    "db:verify-core": "node --conditions=react-server --import tsx db/verify-core-backend.ts",
    "db:verify-stripe": "node --conditions=react-server --import tsx db/verify-stripe-backend.ts",
    "db:seed": "tsx db/seed.ts",
    "db:import-translated-novels": "tsx db/import-translated-novels.ts",
    "db:reconcile-engagement": "tsx db/reconcile-engagement.ts",
    "benchmark:cache": "node scripts/cache-benchmark.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run db:check && npm run build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@hookform/resolvers": "^5.2.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "redis": "^6.2.1",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
